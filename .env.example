# Copy to .env for Docker. Leave DB_HOST blank to use SQLite when you run Django on the host.
SECRET_KEY=change-me-before-production
DEBUG=True
DJANGO_ENV=development

DB_NAME=abrental
DB_USER=postgres
DB_PASSWORD=postgres
DB_PORT=5432

ALLOWED_HOSTS=localhost,127.0.0.1,backend
CSRF_TRUSTED_ORIGINS=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
FRONTEND_ORIGIN=http://localhost:3000

DEFAULT_FROM_EMAIL=notices@localhost
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Optional Azure Blob storage (Canada Central). Leave blank to store files on disk.
AZURE_ACCOUNT_NAME=
AZURE_ACCOUNT_KEY=
AZURE_CONTAINER=suite-files
